{
    "name": "discord-hyperion",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "start": "pnpm --filter @hyperion/dev-bot start",
        "dev": "pnpm --filter @hyperion/dev-bot dev",
        "start:debug": "pnpm --filter @hyperion/dev-bot start:debug",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "build": "pnpm --filter @hyperion/core build",
        "verify:package": "node scripts/verify-package.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.15.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.15.0",
    "type": "module",
    "devDependencies": {
        "@biomejs/biome": "2.6.2",
        "@types/node": "^26.6.5",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "discord.js": "15.0.0-dev.1792497873-5050a3b54",
        "@discordjs/builders": "2.0.0-dev.1792497873-5050a3b54"
    },
    "private": true
}
