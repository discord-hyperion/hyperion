{
    "name": "discord-hyperion",
    "version": "1.0.0",
    "description": "",
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "start": "pnpm --filter @hyperion/dev-bot start",
        "dev": "pnpm --filter @hyperion/dev-bot dev",
        "start:debug": "pnpm --filter @hyperion/dev-bot start:debug",
        "check": "biome check . && node scripts/check-docs.mjs && node scripts/check-examples.mjs && node scripts/check-layout.mjs",
        "check:docs": "node scripts/check-docs.mjs",
        "check:fix": "node scripts/fix-changed.mjs",
        "check:fix:all": "node scripts/check-layout.mjs --fix && biome check --write .",
        "lint": "biome lint .",
        "test": "turbo run test --cache=local:rw",
        "typecheck": "turbo run typecheck --cache=local:rw",
        "build": "turbo run build --cache=local:rw",
        "verify:package": "node scripts/verify-package.mjs",
        "verify:cache": "node scripts/verify-cache.mjs",
        "changeset": "changeset",
        "version-packages": "node scripts/version-packages.mjs",
        "verify:release": "node scripts/verify-release.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.15.0",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@12.15.0",
    "type": "module",
    "devDependencies": {
        "@babel/parser": "7.29.12",
        "@biomejs/biome": "2.6.2",
        "@changesets/cli": "3.0.3",
        "@discordjs/builders": "2.0.0-dev.1792497873-5050a3b54",
        "@types/node": "^26.6.5",
        "discord.js": "15.0.0-dev.1792497873-5050a3b54",
        "tsx": "^4.23.15",
        "turbo": "2.11.10",
        "typescript": "^7.0.2"
    },
    "private": true
}
