{
    "name": "@hyperion/sqlite",
    "version": "0.1.0",
    "type": "module",
    "license": "ISC",
    "engines": {
        "node": ">=24.17.0"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "build": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
        "prepack": "pnpm build"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "peerDependencies": {
        "better-sqlite3": "^13.0.3"
    },
    "dependencies": {
        "@standard-schema/spec": "^1.1.0",
        "@types/better-sqlite3": "^9.6.0"
    },
    "devDependencies": {
        "better-sqlite3": "^13.0.3",
        "valibot": "^1.5.0"
    },
    "exports": {
        ".": "./lib/index.ts"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/favylicious/discord-hyperion.git",
        "directory": "packages/sqlite"
    }
}
