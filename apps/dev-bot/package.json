{
    "name": "@hyperion-js/dev-bot",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "start": "tsx --env-file-if-exists=.env index.ts",
        "dev": "tsx watch --env-file-if-exists=.env index.ts",
        "start:debug": "tsx --inspect --env-file-if-exists=.env index.ts"
    },
    "dependencies": {
        "@hyperion-js/core": "workspace:*",
        "discord.js": "15.0.0-dev.1792497873-5050a3b54",
        "@discordjs/builders": "2.0.0-dev.1792497873-5050a3b54",
        "valibot": "^1.5.0",
        "date-fns": "^4.4.0",
        "@hyperion-js/jsx": "workspace:*",
        "@hyperion-js/sqlite": "workspace:*",
        "better-sqlite3": "^13.0.3"
    }
}
