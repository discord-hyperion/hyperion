{
    "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!pnpm-lock.yaml",
            "!.agents/skills",
            "!skills-lock.json"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useArrowFunction": "error"
            },
            "correctness": {
                "noUnusedImports": "error",
                "noUnusedVariables": "error",
                "useImportExtensions": "error"
            },
            "style": {
                "useConsistentMemberAccessibility": {
                    "level": "error",
                    "options": { "accessibility": "noPublic" }
                },
                "useConsistentTypeDefinitions": {
                    "level": "error",
                    "options": { "style": "type" }
                },
                "useImportType": "error"
            }
        }
    },
    "javascript": {
        "formatter": {
            "arrowParentheses": "asNeeded",
            "quoteStyle": "double"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "markdown": {
        "parser": {
            "frontmatter": true
        }
    }
}
